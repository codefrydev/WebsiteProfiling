{
  "Urls": "http://+:8090",
  "Upstream": {
    "FastApiBaseUrl": "http://127.0.0.1:8096",
    "FileServiceBaseUrl": "http://127.0.0.1:8080",
    "TimeoutSeconds": 120
  },
  "Auth": {
    "CookieSameSite": "Lax",
    "CookieSecure": false,
    "DefaultRole": "analyst"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
