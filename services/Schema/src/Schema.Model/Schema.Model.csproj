<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Schema.Model</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\WebsiteProfiling.Data\WebsiteProfiling.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 / Npgsql 10 wave, matching the version already pinned by every other service. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- Design-time tooling only (dotnet ef migrations/scaffold) — never shipped, never needed at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" PrivateAssets="all" />
    <!--
      Design's exact 10.0.9 pin forces this project's own build to resolve
      Microsoft.EntityFrameworkCore.Relational to 10.0.9 (Npgsql only requires >=10.0.4). Because
      Design is PrivateAssets="all", that resolution doesn't flow to consumers (Schema.Migrator,
      Schema.Tests) via ProjectReference, so without this explicit (non-private) pin they'd resolve
      the lower 10.0.4 and fail to load the 10.0.9 Schema.Model.dll (CS1705).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
  </ItemGroup>

</Project>
